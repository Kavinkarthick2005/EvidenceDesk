# EvidenceDesk local configuration template
# Copy to .env for local development when the application is implemented.
# Never commit .env or real credentials.

APP_ENV=development
APP_NAME=EvidenceDesk
APP_LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL
POSTGRES_DB=evidencedesk
POSTGRES_USER=evidencedesk
POSTGRES_PASSWORD=replace_with_a_local_secret
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://evidencedesk:replace_with_a_local_secret@127.0.0.1:5432/evidencedesk


# Document storage
DOCUMENT_STORAGE_PATH=./data/documents
MAX_UPLOAD_SIZE_MB=25

# Embeddings
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# Generation
# Select and validate a provider during implementation.
GENERATION_PROVIDER=mock
GENERATION_MODEL=
GENERATION_API_KEY=

# Retrieval
RETRIEVAL_TOP_K=5
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# Optional background processing; not required for the first API milestone.
REDIS_URL=redis://localhost:6379/0
